rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: is admin
    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email in ['sukhigopi2006@gmail.com', 'admin@sukhi.com', 'owner@sukhi.com'];
    }
    
    // Helper: is owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products are public to browse and managed directly by the store admin.
    match /products/{productId} {
      allow read, create, update, delete: if true;
    }

    // Users - owner read/write their own data, admin read all
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Orders - customers can create order requests, admin can read/update/delete all
    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    // Customers - allow create and manage customer profiles
    match /customers/{customerId} {
      allow read, write, delete: if true;
    }

    // Promotional offers - public read, admin write and delete
    match /offers/{offerId} {
      allow read, write, delete: if true;
    }
  }
}
