rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: is admin
    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email in ['sukhigopi2006@gmail.com', 'admin@sukhi.com', 'owner@sukhi.com'];
    }
    
    // Helper: is owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products are public to browse, but only the authenticated admin manages catalog data.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users - owner read/write their own data, admin read all
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders - customers can create order requests, admin can read/update all
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    // Customers - allow create and manage customer profiles
    match /customers/{customerId} {
      allow read, write: if isAdmin() || isOwner(customerId);
    }

    // Promotional offers - public read, admin write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
